<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lottery.mapper.Kl8DrawMapper">

    <resultMap id="BaseResultMap" type="com.lottery.entity.Kl8Draw">
        <id     column="id"         property="id"/>
        <result column="issue"      property="issue"/>
        <result column="n_1"        property="n1"/>
        <result column="n_2"        property="n2"/>
        <result column="n_3"        property="n3"/>
        <result column="n_4"        property="n4"/>
        <result column="n_5"        property="n5"/>
        <result column="n_6"        property="n6"/>
        <result column="n_7"        property="n7"/>
        <result column="n_8"        property="n8"/>
        <result column="n_9"        property="n9"/>
        <result column="n_10"       property="n10"/>
        <result column="n_11"       property="n11"/>
        <result column="n_12"       property="n12"/>
        <result column="n_13"       property="n13"/>
        <result column="n_14"       property="n14"/>
        <result column="n_15"       property="n15"/>
        <result column="n_16"       property="n16"/>
        <result column="n_17"       property="n17"/>
        <result column="n_18"       property="n18"/>
        <result column="n_19"       property="n19"/>
        <result column="n_20"       property="n20"/>
        <result column="draw_date"  property="drawDate"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, issue, n_1, n_2, n_3, n_4, n_5, n_6, n_7, n_8, n_9, n_10,
        n_11, n_12, n_13, n_14, n_15, n_16, n_17, n_18, n_19, n_20,
        draw_date, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.lottery.entity.Kl8Draw" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO kl8_draw (issue, n_1, n_2, n_3, n_4, n_5, n_6, n_7, n_8, n_9, n_10,
            n_11, n_12, n_13, n_14, n_15, n_16, n_17, n_18, n_19, n_20, draw_date)
        VALUES (#{issue}, #{n1}, #{n2}, #{n3}, #{n4}, #{n5}, #{n6}, #{n7}, #{n8}, #{n9}, #{n10},
            #{n11}, #{n12}, #{n13}, #{n14}, #{n15}, #{n16}, #{n17}, #{n18}, #{n19}, #{n20}, #{drawDate})
    </insert>

    <insert id="insertBatch" parameterType="map">
        INSERT INTO kl8_draw (issue, n_1, n_2, n_3, n_4, n_5, n_6, n_7, n_8, n_9, n_10,
            n_11, n_12, n_13, n_14, n_15, n_16, n_17, n_18, n_19, n_20, draw_date)
        VALUES
        <foreach collection="list" item="d" separator=",">
            (#{d.issue}, #{d.n1}, #{d.n2}, #{d.n3}, #{d.n4}, #{d.n5}, #{d.n6}, #{d.n7}, #{d.n8}, #{d.n9}, #{d.n10},
             #{d.n11}, #{d.n12}, #{d.n13}, #{d.n14}, #{d.n15}, #{d.n16}, #{d.n17}, #{d.n18}, #{d.n19}, #{d.n20}, #{d.drawDate})
        </foreach>
    </insert>

    <update id="updateById" parameterType="com.lottery.entity.Kl8Draw">
        UPDATE kl8_draw
        <set>
            <if test="issue != null">issue = #{issue},</if>
            <if test="n1 != null">n_1 = #{n1},</if>
            <if test="n2 != null">n_2 = #{n2},</if>
            <if test="n3 != null">n_3 = #{n3},</if>
            <if test="n4 != null">n_4 = #{n4},</if>
            <if test="n5 != null">n_5 = #{n5},</if>
            <if test="n6 != null">n_6 = #{n6},</if>
            <if test="n7 != null">n_7 = #{n7},</if>
            <if test="n8 != null">n_8 = #{n8},</if>
            <if test="n9 != null">n_9 = #{n9},</if>
            <if test="n10 != null">n_10 = #{n10},</if>
            <if test="n11 != null">n_11 = #{n11},</if>
            <if test="n12 != null">n_12 = #{n12},</if>
            <if test="n13 != null">n_13 = #{n13},</if>
            <if test="n14 != null">n_14 = #{n14},</if>
            <if test="n15 != null">n_15 = #{n15},</if>
            <if test="n16 != null">n_16 = #{n16},</if>
            <if test="n17 != null">n_17 = #{n17},</if>
            <if test="n18 != null">n_18 = #{n18},</if>
            <if test="n19 != null">n_19 = #{n19},</if>
            <if test="n20 != null">n_20 = #{n20},</if>
            <if test="drawDate != null">draw_date = #{drawDate}</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM kl8_draw WHERE id = #{id}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM kl8_draw WHERE id = #{id}
    </select>

    <select id="selectByIssue" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM kl8_draw WHERE issue = #{issue} LIMIT 1
    </select>

    <!-- 号码匹配片段：给定一个号码 #{n}，匹配 20 列中的任一个 -->
    <sql id="numberMatch">
        (n_1 = #{n} OR n_2 = #{n} OR n_3 = #{n} OR n_4 = #{n} OR n_5 = #{n}
         OR n_6 = #{n} OR n_7 = #{n} OR n_8 = #{n} OR n_9 = #{n} OR n_10 = #{n}
         OR n_11 = #{n} OR n_12 = #{n} OR n_13 = #{n} OR n_14 = #{n} OR n_15 = #{n}
         OR n_16 = #{n} OR n_17 = #{n} OR n_18 = #{n} OR n_19 = #{n} OR n_20 = #{n})
    </sql>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM kl8_draw
        <where>
            <if test="issue != null and issue != ''">
                AND issue LIKE CONCAT('%', #{issue}, '%')
            </if>
            <if test="numberList != null and numberList.size() > 0">
                <foreach collection="numberList" item="n">
                    AND <include refid="numberMatch"/>
                </foreach>
            </if>
            <if test="startDate != null">AND draw_date <![CDATA[ >= ]]> #{startDate}</if>
            <if test="endDate != null">AND draw_date <![CDATA[ <= ]]> #{endDate}</if>
        </where>
        ORDER BY draw_date DESC, issue DESC
        <if test="offset != null and limit != null">
            LIMIT #{offset}, #{limit}
        </if>
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(1) FROM kl8_draw
        <where>
            <if test="issue != null and issue != ''">
                AND issue LIKE CONCAT('%', #{issue}, '%')
            </if>
            <if test="numberList != null and numberList.size() > 0">
                <foreach collection="numberList" item="n">
                    AND <include refid="numberMatch"/>
                </foreach>
            </if>
            <if test="startDate != null">AND draw_date <![CDATA[ >= ]]> #{startDate}</if>
            <if test="endDate != null">AND draw_date <![CDATA[ <= ]]> #{endDate}</if>
        </where>
    </select>

    <select id="selectLatest" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM kl8_draw ORDER BY draw_date DESC, issue DESC LIMIT 1
    </select>

    <select id="countByIssue" resultType="int">
        SELECT COUNT(1) FROM kl8_draw WHERE issue = #{issue}
    </select>
</mapper>
